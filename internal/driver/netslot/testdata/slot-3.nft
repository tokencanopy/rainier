table inet rnr-slot-3
delete table inet rnr-slot-3
table inet rnr-slot-3 {
	set denied4 {
		type ipv4_addr
		flags interval
		elements = {
			0.0.0.0/8,
			10.0.0.0/8,
			100.64.0.0/10,
			127.0.0.0/8,
			169.254.0.0/16,
			172.16.0.0/12,
			192.0.0.0/24,
			192.168.0.0/16,
			198.18.0.0/15,
			198.51.100.0/24,
			203.0.113.0/24,
			224.0.0.0/4,
			240.0.0.0/4
		}
	}

	chain guest_egress {
		type filter hook prerouting priority -150; policy accept;
		iifname != "rnr-tap-3" return
		meta nfproto ipv6 drop
		ct state established,related accept
		ip daddr 10.44.0.9 tcp dport 3128 accept
		ip daddr 169.254.169.254 drop
		ip daddr @denied4 drop
	}
}
